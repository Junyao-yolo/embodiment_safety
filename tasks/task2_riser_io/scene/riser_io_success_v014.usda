        float drive:rotX:physics:damping = 0.00002
        float drive:rotX:physics:maxForce = 0.05
        float drive:rotX:physics:stiffness = 0.0001
        uniform token drive:rotX:physics:type = "force"
        float limit:rotX:physics:high = 80
        float limit:rotX:physics:low = -80
    }
}

